Exec=garuda-toolbox
Icon=garuda-toolbox
Terminal=false
StartupNotify=true
StartupWMClass=garuda-toolbox
SingleMainWindow=true
Categories=System;
Keywords=update;upgrade;package;pacman;aur;maintenance;systemd;services;kernel;locale;users;boot;grub;network;diagnostics;configuration;settings;
Actions=maintenance;diagnostics;setup-assistant;

[Desktop Action maintenance]
Name=Maintenance
Exec=garuda-toolbox --page maintenance

[Desktop Action diagnostics]
Name=Diagnostics
Exec=garuda-toolbox --page diagnostics

[Desktop Action setup-assistant]
Name=Setup Assistant
Exec=garuda-toolbox --setup-assistant
