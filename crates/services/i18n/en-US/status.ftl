# Why a probe failed. The parts that the system printed stay as they are.
probe-cause-command = { $command } ended with { $status }: { $stderr }
probe-cause-exit-code = exit code { $code }
probe-cause-signal = a signal
probe-cause-timed-out = { $command }: no answer within { $seconds } s, stopped
probe-cause-cancelled = { $command }: cancelled
probe-cause-too-large = { $command }: the program printed too much
probe-cause-what = { $what }: { $error }
probe-cause-not-utf8 = { $what } is not UTF-8: { $raw }
probe-cause-user-id = { $path } names no user id
probe-cause-root = { $path } lists no root
probe-cause-boot-time = no boot time in /proc/stat
probe-cause-kernel-release = the kernel names no release
probe-cause-not-a-file = { $path } is no file
probe-cause-nul-in-path = { $path }: NUL in the path
probe-cause-panicked = the probe panicked
# $kind is a kind of name, $reason says why the value breaks its rule.
probe-cause-name = { $kind } `{ $value }` is invalid: { $reason }
probe-cause-listing = lsblk printed no device list: { $words }
probe-cause-order-line = paru printed an incomplete order line: { $line }
# The phrase a failed read names, when the source is not a path or a command.
probe-subject-local-database = the local database
probe-subject-disks = the disks
probe-subject-running-kernel = the running kernel
probe-subject-route-list = ip printed no route list
probe-subject-build-order = the build order of { $package }
probe-subject-sample-build-order = the sample build order of { $package }
name-reason-empty = it is empty
name-reason-too-long = it is longer than { $max } characters
name-reason-invalid-start = it must not start with `{ $character }`
name-reason-invalid-character = it contains `{ $character }`
name-reason-unknown-unit-type = it needs a unit type suffix such as `.service`
name-reason-invalid-component = it is no absolute path without `.` and `..` parts
name-reason-wrong-file-type = its file type does not fit
name-reason-unknown-device = it is no disk, partition or mapped device as the kernel names them
