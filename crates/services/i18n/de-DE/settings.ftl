settings-language = Sprache
settings-language-description = Die Texte wechseln sofort. Eine unvollständige Sprache zeigt die fehlenden Texte auf Englisch.
settings-language-system = Systemsprache
settings-theme = Erscheinungsbild
settings-theme-description = Hell, dunkel oder passend zum Desktop.
settings-theme-desktop = Wie der Desktop
settings-theme-dark = Dunkel
settings-theme-light = Hell
settings-dark-scheme = Dunkle Farben
settings-dark-scheme-description = Farben, solange das Erscheinungsbild dunkel ist. Bei „System“ werden Farben und Akzentfarbe des Desktops übernommen.
settings-light-scheme = Helle Farben
settings-light-scheme-description = Farben, solange das Erscheinungsbild hell ist. Bei „System“ werden Farben und Akzentfarbe des Desktops übernommen.
settings-scheme-system = System
settings-motion = Weniger Animationen
settings-motion-description = Bereiche und Hinweise erscheinen sofort, statt einzugleiten und einzublenden.
settings-motion-system = Wie das System
settings-motion-reduced = An
settings-motion-full = Aus

settings-autostart = Beim Anmelden starten
settings-autostart-description = Öffnet das Fenster bei jeder Anmeldung.
settings-refresh-auto = Automatisch nach Updates suchen
settings-refresh-auto-description = Bei jeder Prüfung werden die Paketlisten heruntergeladen und das AUR (Arch User Repository) abgefragt. Ist sie ausgeschaltet, prüft die Startseite nur nach einem Klick auf „Neu einlesen“.
settings-refresh-interval = Zeit zwischen den Prüfungen
settings-refresh-interval-description = Zwischen 5 Minuten und einmal am Tag (1440 Minuten).
settings-refresh-minutes = Prüfintervall in Minuten
settings-refresh-unit = Min.
settings-refresh-clamped = Das Intervall liegt zwischen 5 Minuten und einem Tag. Verwendet werden daher { $minutes } Minuten.
settings-user-units = Dienste beim Öffnen
settings-user-units-description = Legt fest, welche Units die Seite „Dienste“ beim Öffnen auflistet.
settings-user-units-system = System
settings-user-units-user = Mein Konto
settings-aur = AUR-Pakete anzeigen
settings-aur-description = Die Seite „Pakete“ zeigt auch Pakete aus dem Arch User Repository. Die Liste wird höchstens einmal am Tag heruntergeladen. AUR-Pakete sind Community-Skripte, die lokal gebaut werden.

settings-copy-reports = Berichte in die Zwischenablage kopieren
settings-copy-reports-description = Ein fertiger Bericht wird sofort kopiert, ebenso der Link nach dem Hochladen. Das gilt auch für die Konsolenausgabe.
settings-log-level = Detailgrad der Logdatei
settings-log-level-description = Legt fest, wie viel Garuda Toolbox in die Logdatei schreibt. Vor einer Problemmeldung sollte „Ausführlich“ gewählt werden.
settings-log-error = Nur Fehler
settings-log-warn = Warnungen und Fehler
settings-log-info = Normal
settings-log-debug = Ausführlich
settings-log-trace = Alles
settings-blur-desktop = Den Desktop hinter dem Fenster weichzeichnen
settings-blur-desktop-description = Zeichnet den Desktop hinter dem Fenster weich.
settings-blur-desktop-unavailable = Dieser Desktop bietet keine Weichzeichnung hinter Fenstern.
