# System Tweaks' system-wide choices.

tweaks-shell-network = Shell und Netzwerk
tweaks-garuda-update = Garuda Update
tweaks-unavailable = Hier nicht verfügbar
tweaks-other = Sonstiges
tweaks-queued = Wird beim Übernehmen geändert

tweaks-shell = Login-Shell
tweaks-shell-description = Empfohlen wird eine POSIX-kompatible Shell wie Bash oder Zsh. Fish solltest du nur über das Profil deines Terminals verwenden.
tweaks-dns = DNS-Server
tweaks-dns-description = Server, die für diesen Computer die Namen von Websites in IP-Adressen auflösen.
tweaks-wifi = WLAN-Backend
tweaks-wifi-description = iwd ist eine schlankere Alternative zu wpa_supplicant. Es verbindet sich oft schneller und wechselt besser zwischen Zugangspunkten.
tweaks-hblock = Werbeblocker
tweaks-hblock-description = Blockiert Werbung, Tracker und Schadsoftware-Domains mit hblock.

tweaks-dns-default = Aus deinem Netzwerk (Standard)
tweaks-dns-google = Google (8.8.8.8)
tweaks-dns-cloudflare = Cloudflare (1.1.1.1)
tweaks-dns-quad9 = Quad9 (9.9.9.9)
tweaks-wifi-wpa-supplicant = wpa_supplicant (Standard)
tweaks-wifi-iwd = iwd

tweaks-flag-skip-mirrorlist = Mirrorliste nicht aktualisieren
tweaks-flag-skip-mirrorlist-description = Vor Systemaktualisierungen werden nicht die schnellsten Arch-Spiegelserver für die Mirrorliste ermittelt.
tweaks-flag-update-aur = AUR-Pakete aktualisieren
tweaks-flag-update-aur-description = Aktualisiert bei Systemaktualisierungen auch Pakete aus dem Arch User Repository (AUR).
tweaks-flag-pacman-noconfirm = pacman ohne Rückfragen
tweaks-flag-pacman-noconfirm-description = Führt die Paketverwaltung pacman ohne Rückfragen aus, damit Updates schneller durchlaufen. Bei jeder Frage wird die Standardantwort gewählt.
tweaks-flag-no-check-space = Speicherplatz nicht prüfen
tweaks-flag-no-check-space-description = Prüft vor dem Installieren von Paketen nicht, ob genug Speicherplatz frei ist.
